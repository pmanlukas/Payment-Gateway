      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  t.id,\n  t.customer_email AS email,\n  t.amount,\n  CAST(t.risk_score AS DECIMAL(10,2)) AS risk_score,\n  t.ip_address,\n  t.created_date\nFROM transactions t\nWHERE t.risk_score IS NOT NULL\n  AND t.risk_score != ''\n  AND CAST(t.risk_score AS DECIMAL(10,2)) >= 5\nORDER BY CAST(t.risk_score AS DECIMAL(10,2)) DESC, t.created_date DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "High Risk Transactions (Risk Score >= 5)",
