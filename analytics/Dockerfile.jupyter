FROM jupyter/scipy-notebook:latest

USER root

# Install MySQL client and other system dependencies
RUN apt-get update && apt-get install -y \
    default-mysql-client \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python packages (do as root, then chown)
COPY requirements.txt /tmp/requirements.txt
RUN chown $NB_UID:$NB_GID /tmp/requirements.txt

USER $NB_UID

RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Create directories for notebooks, data, and Jupyter runtime
RUN mkdir -p /home/jovyan/work/notebooks \
    /home/jovyan/work/data \
    /home/jovyan/work/scripts \
    /home/jovyan/.local/share \
    /home/jovyan/.jupyter

# Set working directory
WORKDIR /home/jovyan/work

# Expose Jupyter port
EXPOSE 8888

# Start Jupyter Lab
CMD ["start-notebook.sh", "--NotebookApp.token=''", "--NotebookApp.password=''"]
